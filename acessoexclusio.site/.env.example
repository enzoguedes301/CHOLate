# ==========================================================================
#  EXEMPLO de variáveis de ambiente. Copie para `.env` e preencha.
#  O `.env` real NÃO é versionado (está no .gitignore).
# ==========================================================================

# --- Gateway PIX (Medusa Pay) ---
# Docs: https://app.medusapayoficial.pro/docs
MEDUSA_BASE=https://api.medusapayoficial.pro/api/v1
# API Key enviada no header `Authorization: Bearer <key>` (prefixo mk_live_)
MEDUSA_API_KEY=
# ID da empresa (Medusa Pay)
MEDUSA_EMPRESA_ID=

# --- API de consulta de CPF ---
CPF_API_TOKEN=

# --- Chave para ver/baixar os leads capturados ---
# Acesse: /api/leads-ver.php?key=<esta_chave>
LEADS_KEY=

# --- Meta Pixel / API de Conversões (CAPI) ---
META_PIXEL_ID=
# Token de acesso da API de Conversões (secreto — só server-side)
META_CAPI_TOKEN=

# --- Porta do servidor Node ---
# Padrão 3001 (local). Em hospedagem (HostGator) não defina: a plataforma
# injeta a porta via variável PORT e ela tem prioridade. Deixe comentado.
# PORT=3001

# --- Modo DEV ---
# "1" injeta o overlay de navegação do funil (setas) — SÓ em localhost.
# Em produção DEIXE 0.
DEV_MODE=0
